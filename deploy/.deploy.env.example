# Copy this file to deploy/.deploy.env and fill in real values.
# The real file is gitignored.

# SSH connection details
SSH_HOST=divstrong.com
SSH_USER=deploy
SSH_PORT=22

# Absolute path to the Laravel app root on the remote server
# (the directory that contains artisan, composer.json, public/, etc.)
REMOTE_PATH=/var/www/divstrong/server

# Branch to deploy from
BRANCH=master

# PHP-FPM service name on the remote (used for opcache reset). Leave empty to skip.
# Example: php8.3-fpm
FPM_SERVICE=

# Set to 1 to require passwordless sudo on the remote (for FPM reload). 0 to skip sudo.
USE_SUDO=0
