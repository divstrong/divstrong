APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

VITE_APP_NAME="${APP_NAME}"

# --- Prospecting -------------------------------------------------------------
# "Find Prospects" searches for creative and media agencies, reads contact details
# off their own sites, and imports the ones with a verified, named address.
#
# Google Places is the cheap path — a few cents per hundred agencies, no tokens —
# but it publishes no names, so only about one in four ends up addressable. Needs
# "Places API (New)" enabled on the project. Without it, discovery falls back to
# Claude web search using ANTHROPIC_API_KEY, which finds names and costs tokens.
GOOGLE_MAPS_API_KEY=

# Which source to use: places | model | auto (auto prefers Places when keyed).
PROSPECTING_SOURCE=auto

# Discovery is web-search-grounded extraction across many calls, so it runs on a
# smaller model than ANTHROPIC_MODEL (which is Opus, for RFP analysis).
PROSPECTING_MODEL=claude-sonnet-5

# Mailbox verification connects to the recipient's mail server on port 25 and asks
# whether the address exists, stopping before DATA so nothing is delivered. Most
# hosts block outbound 25; blocked reads as "unknown", never as "invalid". Turn it
# off if your host's abuse policy objects.
PROSPECTING_SMTP_PROBE=true

# --- Cold outreach compliance ------------------------------------------------
# CAN-SPAM requires a real postal address on every commercial email. No default on
# purpose: until this is set the footer omits the block, and a wrong address is
# worse than an obviously missing one. A PO box or registered agent is acceptable.
OUTREACH_POSTAL_ADDRESS=

# Where the outreach emails send people to book time.
OUTREACH_SCHEDULE_URL=https://divstrong.com/contact

# Postmark event webhook (opens/clicks/bounces/spam complaints), which is what makes
# the engagement chips on Prospects mean anything. Configure the webhook in Postmark as
#   https://user:SECRET@yourhost/api/webhooks/postmark
# and set this to match SECRET. Unset, the endpoint rejects everything.
POSTMARK_WEBHOOK_SECRET=

# --- Proposal PDF rendering (headless Chrome via Puppeteer) ---
# Node binary, if it is not on the web user's PATH.
NODE_BINARY=node
# Where Puppeteer downloaded Chrome. Required whenever the web user has no usable
# HOME (php-fpm often does not), since Puppeteer looks in ~/.cache/puppeteer.
# PUPPETEER_CACHE_DIR=/home/forge/.cache/puppeteer
# Use a system Chrome instead of Puppeteer's download.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# Seconds to allow for a render.
PDF_RENDER_TIMEOUT=180
# Only for servers that cannot handle a second request while the PDF request is in
# flight (`php artisan serve` on Windows is single-threaded and deadlocks against
# itself). Point it at a second instance: php artisan serve --port=8001
# PDF_RENDER_BASE_URL=http://localhost:8001
